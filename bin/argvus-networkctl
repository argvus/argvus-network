#!/usr/bin/env sh

set -eu
# shellcheck disable=SC1091
. /usr/share/argvus/lib/i18n.sh

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send "$(argvus_tr network notification.title)" "$1" >/dev/null 2>&1 || true
}

msg() {
  argvus_tr network "message.$1"
}

nmcli_available() {
  command -v nmcli >/dev/null 2>&1
}

nmcli_timeout() {
  if command -v timeout >/dev/null 2>&1; then
    timeout 5s nmcli "$@"
  else
    nmcli "$@"
  fi
}

ip_available() {
  command -v ip >/dev/null 2>&1
}

default_iface() {
  ip_available || return 0
  ip route show default 2>/dev/null | awk 'NR == 1 { print $5; exit }'
}

first_connected_iface() {
  nmcli_available || return 0
  nmcli_timeout -t -f DEVICE,STATE device status 2>/dev/null |
    awk -F: '$2 == "connected" && $1 != "lo" { print $1; exit }'
}

active_iface() {
  # NetworkManager's device state is authoritative for whether a connection
  # is active. A stale kernel default route must not turn disconnected into a
  # connected status.
  if nmcli_available; then
    first_connected_iface
    return 0
  fi
  default_iface
}

iface_type() {
  iface="$1"
  [ -n "$iface" ] || return 0
  nmcli_available || return 0
  nmcli_timeout -g GENERAL.TYPE device show "$iface" 2>/dev/null | awk 'NR == 1 { print; exit }'
}

iface_ip() {
  iface="$1"
  [ -n "$iface" ] || return 0
  ip_available || return 0
  ip -4 addr show "$iface" 2>/dev/null |
    awk '/inet / { print $2; exit }' |
    cut -d/ -f1
}

iface_ssid() {
  iface="$1"
  [ -n "$iface" ] || return 0

  if command -v iwgetid >/dev/null 2>&1; then
    iwgetid -r "$iface" 2>/dev/null || true
    return 0
  fi

  nmcli_available || return 0
  nmcli_timeout -t -f ACTIVE,SSID device wifi list ifname "$iface" 2>/dev/null |
    awk -F: '$1 == "yes" { print $2; exit }'
}

net_bytes() {
  iface="$1"
  direction="$2"
  path="/sys/class/net/$iface/statistics/${direction}_bytes"
  if [ -r "$path" ]; then
    sed -n '1p' "$path" 2>/dev/null || printf '0\n'
  else
    printf '0\n'
  fi
}

networking_state() {
  if nmcli_available; then
    nmcli_timeout -t networking 2>/dev/null || printf 'unknown\n'
  else
    printf 'unknown\n'
  fi
}

wifi_state() {
  if nmcli_available; then
    nmcli_timeout -t radio wifi 2>/dev/null || printf 'unknown\n'
  else
    printf 'unknown\n'
  fi
}

connectivity_state() {
  if nmcli_available; then
    nmcli_timeout -t -g CONNECTIVITY general 2>/dev/null || printf 'unknown\n'
  else
    printf 'unknown\n'
  fi
}

print_status() {
  if ! nmcli_available; then
    printf 'available=no\n'
    printf 'networking=unknown\n'
    printf 'wifi=unknown\n'
    printf 'iface=\n'
    printf 'type=\n'
    printf 'ip=\n'
    printf 'ssid=\n'
    printf 'rx=0\n'
    printf 'tx=0\n'
    printf 'connected=no\n'
    printf 'connectivity=unknown\n'
    printf 'status=unavailable\n'
    return 0
  fi

  networking="$(networking_state)"
  wifi="$(wifi_state)"
  connectivity="$(connectivity_state)"
  iface="$(active_iface)"
  type="$(iface_type "$iface")"
  ip_addr="$(iface_ip "$iface")"
  ssid="$(iface_ssid "$iface")"
  connected=no
  status=disconnected

  if [ "$networking" = "disabled" ]; then
    status=disabled
  elif [ -n "$iface" ]; then
    connected=yes
    case "$connectivity" in
      full) status=connected ;;
      limited|portal|none|unknown|'') status=limited ;;
      *) status=limited ;;
    esac
  fi

  printf 'available=yes\n'
  printf 'networking=%s\n' "$networking"
  printf 'wifi=%s\n' "$wifi"
  printf 'iface=%s\n' "$iface"
  printf 'type=%s\n' "$type"
  printf 'ip=%s\n' "$ip_addr"
  printf 'ssid=%s\n' "$ssid"
  printf 'rx=%s\n' "$(net_bytes "$iface" rx)"
  printf 'tx=%s\n' "$(net_bytes "$iface" tx)"
  printf 'connected=%s\n' "$connected"
  printf 'connectivity=%s\n' "$connectivity"
  printf 'status=%s\n' "$status"
}

set_networking() {
  target="$1"
  if ! nmcli_available; then
    notify "$(msg available_no)"
    print_status
    return 0
  fi

  if nmcli_timeout networking "$target" >/dev/null 2>&1; then
    if [ "$target" = "on" ]; then
      notify "$(msg reconnecting)"
    else
      notify "$(msg disconnected)"
    fi
  else
    notify "$(msg available_no)"
  fi

  print_status
}

set_wifi() {
  target="$1"
  if ! nmcli_available; then
    notify "$(msg available_no)"
    print_status
    return 0
  fi

  if nmcli_timeout radio wifi "$target" >/dev/null 2>&1; then
    if [ "$target" = "on" ]; then
      notify "$(msg wifi_enabled)"
    else
      notify "$(msg wifi_disabled)"
    fi
  else
    notify "$(msg available_no)"
  fi

  print_status
}

toggle_networking() {
  case "$(networking_state)" in
    enabled) set_networking off ;;
    disabled) set_networking on ;;
    *) print_status ;;
  esac
}

toggle_wifi() {
  case "$(wifi_state)" in
    enabled) set_wifi off ;;
    disabled) set_wifi on ;;
    *) print_status ;;
  esac
}

open_manager() {
  if command -v nm-connection-editor >/dev/null 2>&1; then
    exec nm-connection-editor
  fi

  if command -v nmtui >/dev/null 2>&1; then
    exec nmtui
  fi

  notify "$(msg manager_missing)"
}

usage() {
  printf '%s\n' "$(argvus_tr network cli.usage command="${0##*/}")" >&2
}

case "${1:-status}" in
  status)
    print_status
    ;;
  toggle)
    toggle_networking
    ;;
  enable|on)
    set_networking on
    ;;
  disable|off)
    set_networking off
    ;;
  manager|menu)
    open_manager
    ;;
  wifi)
    case "${2:-status}" in
      status) printf '%s\n' "$(wifi_state)" ;;
      toggle) toggle_wifi ;;
      enable|on) set_wifi on ;;
      disable|off) set_wifi off ;;
      *) usage; exit 64 ;;
    esac
    ;;
  *)
    usage
    exit 64
    ;;
esac
