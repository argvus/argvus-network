{
  // Merge these keys into the ARGVUS taskbar Waybar config.
  // The Bluetooth module intentionally stays in group/right-2.
  "group/right-1": {
    "orientation": "inherit",
    "spacing": 2,
    "modules": [
      "network"
    ]
  },
  "group/right-2": {
    "orientation": "inherit",
    "modules": [
      "bluetooth"
    ]
  },
  "network": {
    "format-icons": [
      "󰌙",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "\uf0ac",
    "format-disconnected": "\uf127",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 10,
    "nospacing": 1,
    "on-click": "argvus-networkctl manager",
    "on-click-right": "argvus-networkctl toggle"
  },
  "bluetooth": {
    "format": "{icon}",
    "format-connected": "{icon} {num_connections}",
    "format-off": "\uf05e",
    "format-disabled": "\uf05e",
    "format-on": "{icon}",
    "format-no-controller": "\uf05e",
    "format-icons": {
      "enabled": "\uf294",
      "on": "\uf294",
      "connected": "\uf294",
      "off": "\uf05e",
      "disabled": "\uf05e"
    },
    "tooltip-format": "{controller_alias}\t{controller_address}\n{num_connections} device(s) connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-off": "Bluetooth off",
    "tooltip-format-disabled": "Bluetooth disabled",
    "tooltip-format-no-controller": "No Bluetooth controller",
    "on-click": "/usr/share/argvus/scripts/argvus/bluetooth-control.sh toggle",
    "on-click-right": "/usr/share/argvus/scripts/argvus/bluetooth-control.sh manager",
    "interval": 30
  }
}
